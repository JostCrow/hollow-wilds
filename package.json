{
  "name": "the-hollow-wilds",
  "version": "1.0.0",
  "description": "A browser hollowing-collecting adventure with explorable towns, routes, turn-based battles, and JSON saves",
  "main": "src/main.tsx",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/game src/App.tsx src/main.tsx",
    "typecheck": "tsc --noEmit",
    "validate-data": "node --experimental-strip-types scripts/validate-data.ts",
    "test": "node --experimental-strip-types --test src/game/*.test.ts",
    "models:export": "node --experimental-strip-types scripts/export-creature-models.mjs",
    "models:build": "node scripts/build-creature-models.mjs",
    "models:pack": "node scripts/pack-creature-models.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
